#!/usr/bin/env bash
set -euo pipefail

# Remote-side wrapper for remote-code-bridge.
# Intended to be placed before any real `code` binary in PATH.

CONFIG_FILE="${REMOTE_CODE_BRIDGE_CONFIG:-$HOME/.config/remote-code-bridge/remote.env}"
if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
fi

BRIDGE_PORT="${REMOTE_CODE_BRIDGE_PORT:-39731}"
BRIDGE_HOST_ALIAS="${REMOTE_CODE_BRIDGE_HOST_ALIAS:-}"
BRIDGE_TOKEN="${REMOTE_CODE_BRIDGE_TOKEN:-}"

if [[ -z "$BRIDGE_HOST_ALIAS" ]]; then
    echo "remote-code-bridge: REMOTE_CODE_BRIDGE_HOST_ALIAS is not set" >&2
    exit 2
fi

if [[ -z "$BRIDGE_TOKEN" ]]; then
    echo "remote-code-bridge: REMOTE_CODE_BRIDGE_TOKEN is not set" >&2
    exit 2
fi

resolve_path() {
    local input="$1"

    if [[ "$input" == "." ]]; then
        pwd -P
        return
    fi

    if [[ "$input" == /* ]]; then
        printf '%s\n' "$input"
        return
    fi

    if command -v realpath >/dev/null 2>&1; then
        realpath "$input"
    else
        python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$input"
    fi
}

args=()
target="."

while [[ $# -gt 0 ]]; do
    case "$1" in
        -r|--reuse-window|-n|--new-window|-g|--goto)
            args+=("$1")
            shift
            ;;
        --wait|--diff|--merge|--install-extension|--uninstall-extension|--list-extensions)
            echo "remote-code-bridge: unsupported code flag for remote bridge: $1" >&2
            exit 2
            ;;
        --)
            shift
            if [[ $# -gt 0 ]]; then
                target="$1"
            fi
            break
            ;;
        -* )
            echo "remote-code-bridge: unsupported flag: $1" >&2
            exit 2
            ;;
        *)
            target="$1"
            shift
            ;;
    esac
done

resolved_target="$(resolve_path "$target")"

python3 - "$BRIDGE_PORT" "$BRIDGE_TOKEN" "$BRIDGE_HOST_ALIAS" "$resolved_target" "${args[@]}" <<'PY'
import json
import sys
import urllib.error
import urllib.request

port = sys.argv[1]
token = sys.argv[2]
host = sys.argv[3]
path = sys.argv[4]
args = sys.argv[5:]

body = json.dumps({"host": host, "path": path, "args": args}).encode("utf-8")
request = urllib.request.Request(
    f"http://127.0.0.1:{port}/open",
    data=body,
    method="POST",
    headers={
        "Content-Type": "application/json",
        "Authorization": f"Bearer {token}",
    },
)

try:
    with urllib.request.urlopen(request, timeout=5) as response:
        payload = json.loads(response.read().decode("utf-8"))
except urllib.error.HTTPError as exc:
    try:
        payload = json.loads(exc.read().decode("utf-8"))
    except Exception:
        payload = {"error": str(exc)}
    raise SystemExit(f"remote-code-bridge: {payload.get('error', 'request failed')}")
except Exception as exc:
    raise SystemExit(
        "remote-code-bridge: could not reach host bridge. "
        "Check SSH RemoteForward and that remote-code-bridge is running on the host. "
        f"Details: {exc}"
    )

if not payload.get("ok"):
    raise SystemExit(f"remote-code-bridge: {payload.get('error', 'request failed')}")

if payload.get("dry_run"):
    print("dry-run command:", " ".join(payload.get("command", [])))
else:
    print("Opening VS Code on host")
PY
