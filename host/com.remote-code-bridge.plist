<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.remote-code-bridge</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USER/.local/bin/remote-code-bridge</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>REMOTE_CODE_BRIDGE_BIND</key>
    <string>127.0.0.1</string>
    <key>REMOTE_CODE_BRIDGE_PORT</key>
    <string>39731</string>
    <key>REMOTE_CODE_BRIDGE_TOKEN</key>
    <string>replace-with-token</string>
    <key>REMOTE_CODE_BRIDGE_DEFAULT_HOST</key>
    <string>devbox</string>
    <key>REMOTE_CODE_BRIDGE_ALLOWED_HOSTS</key>
    <string>devbox</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/remote-code-bridge.out.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/remote-code-bridge.err.log</string>
</dict>
</plist>
