# Host-side config for remote-code-bridge.

# Keep localhost only. Do not expose this on LAN or public interfaces.
REMOTE_CODE_BRIDGE_BIND=127.0.0.1
REMOTE_CODE_BRIDGE_PORT=39731

# Generate with: openssl rand -hex 32
REMOTE_CODE_BRIDGE_TOKEN=change-me-generate-with-openssl-rand-hex-32

# VS Code CLI executable on the host.
REMOTE_CODE_BRIDGE_CODE_BIN=code

# Default VS Code Remote-SSH alias.
# This must match a Host entry in your host ~/.ssh/config.
REMOTE_CODE_BRIDGE_DEFAULT_HOST=devbox

# Optional comma-separated allowlist. Leave empty to allow any requested alias.
REMOTE_CODE_BRIDGE_ALLOWED_HOSTS=devbox

# Set to 1 for tests. It returns the generated command but does not launch VS Code.
REMOTE_CODE_BRIDGE_DRY_RUN=0
