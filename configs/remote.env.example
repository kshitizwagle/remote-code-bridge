# Remote-side config for remote-code-bridge.

# The remote sees this as localhost because SSH RemoteForward maps it back to host localhost.
REMOTE_CODE_BRIDGE_PORT=39731

# Must match the VS Code Remote-SSH Host alias on your host machine.
REMOTE_CODE_BRIDGE_HOST_ALIAS=devbox

# Must match REMOTE_CODE_BRIDGE_TOKEN in host.env.
REMOTE_CODE_BRIDGE_TOKEN=change-me-generate-with-openssl-rand-hex-32
